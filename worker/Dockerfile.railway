FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
RUN pip install --no-cache-dir 'fastapi>=0.115,<1' 'uvicorn>=0.30,<1'
COPY worker /srv/worker
ENV WORKER_DATA_DIR=/data MAX_CONCURRENT_STREAMS=1 MAX_WORKER_USERS=10 PYTHONUNBUFFERED=1 FFMPEG_THREADS=1
CMD ["sh", "-c", "exec uvicorn worker.server:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1 --no-access-log"]
