FROM python:3.12-slim-bookworm
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg bash sudo curl ca-certificates && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash daytona && echo 'daytona ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/daytona
USER daytona
WORKDIR /home/daytona
CMD ["sleep", "infinity"]
